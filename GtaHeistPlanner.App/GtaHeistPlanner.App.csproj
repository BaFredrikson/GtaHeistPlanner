<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="..\assets\maps\kortz\*.svg"
                      Link="Assets\maps\kortz\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\assets\icons\camera.png"
                      Link="Assets\icons\camera.png" />
    <AvaloniaResource Include="..\assets\icons\mic.PNG"
                      Link="Assets\icons\mic.PNG" />
    <AvaloniaResource Include="..\assets\icons\security.svg"
                      Link="Assets\icons\security.svg" />
    <AvaloniaResource Include="..\assets\icons\loot.png"
                      Link="Assets\icons\loot.png" />
    <AvaloniaResource Include="..\assets\icons\special_loot.png"
                      Link="Assets\icons\special_loot.png" />
    <AvaloniaResource Include="..\assets\icons\truckcargo.png"
                      Link="Assets\icons\truckcargo.png" />
    <AvaloniaResource Include="..\assets\icons\sewer_entrance.png"
                      Link="Assets\icons\sewer_entrance.png" />
    <AvaloniaResource Include="..\assets\icons\rappel.png"
                      Link="Assets\icons\rappel.png" />
    <AvaloniaResource Include="..\assets\icons\elevator.png"
                      Link="Assets\icons\elevator.png" />
    <AvaloniaResource Include="..\assets\icons\keycard.png"
                      Link="Assets\icons\keycard.png" />
    <AvaloniaResource Include="Data\kortz\kortz_loot_spawns.json" />
    <AvaloniaResource Include="Data\kortz\kortz_sewer_graph.json" />
    <AvaloniaResource Include="Data\kortz\kortz_security.json" />
    <Content Include="Data\kortz\kortz_loot_spawns.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Data\kortz\kortz_security.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Data\kortz\kortz_exterior_cameras.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\analysis\kortz\kortz_museum.analysis.json"
             Link="Data\kortz\kortz_museum.analysis.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio.Wasapi" Version="3.0.1" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GtaHeistPlanner.Core\GtaHeistPlanner.Core.csproj" />
    <ProjectReference Include="..\GtaHeistPlanner.Voice\GtaHeistPlanner.Voice.csproj" />
  </ItemGroup>
</Project>
