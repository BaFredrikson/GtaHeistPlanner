<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GtaHeistPlanner.App.ViewModels"
             xmlns:controls="using:GtaHeistPlanner.App.Controls"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="GtaHeistPlanner.App.Views.MapCardView" x:DataType="vm:MapCardViewModel">
  <Border Margin="4" Padding="6" Background="#0B0E12"
          BorderBrush="#303946" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="5">
        <Button Padding="5,2" HorizontalAlignment="Left" Background="Transparent" Command="{Binding SelectMapCommand}">
          <TextBlock Text="{Binding Map.DisplayName}" FontSize="15" FontWeight="SemiBold" Foreground="#F1F4F7" />
        </Button>
        <Button Grid.Column="1" Width="30" Height="28" Padding="0" Content="−" ToolTip.Tip="Zoom out" Command="{Binding ZoomOutCommand}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        <Button Grid.Column="2" Width="30" Height="28" Padding="0" Content="+" ToolTip.Tip="Zoom in" Command="{Binding ZoomInCommand}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        <Button Grid.Column="3" Width="48" Height="28" Padding="0" Content="Reset" ToolTip.Tip="Fit complete map" Command="{Binding ResetViewportCommand}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        <Button Grid.Column="4" Width="30" Height="28" Padding="0" Content="{Binding FocusGlyph}" ToolTip.Tip="Toggle focused map" Command="{Binding FocusMapCommand}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      </Grid>

      <controls:MapViewportControl Grid.Row="1" ClipToBounds="True"
                                   Zoom="{Binding Viewport.Zoom}" PanX="{Binding Viewport.PanX}" PanY="{Binding Viewport.PanY}">
        <Grid>
          <svg:Svg Path="{Binding AssetUri}" Stretch="Uniform" />
          <controls:SecurityOverlayControl Calibration="{Binding Owner.CurrentCalibration}"
              ShowSecurity="False" ShowCameras="False" ShowCameraCones="False"
              ShowLoot="{Binding ShowLoot}" ShowUnknownLootClearly="{Binding ShowUnknownLootClearly}"
              LootMarkers="{Binding Owner.LootMarkers}" MapId="{Binding Map.Id}"
              ViewportZoom="{Binding Viewport.Zoom}"
              MapAspectRatio="{Binding Map.AspectRatio}" IsLootEditMode="{Binding IsLootEditMode}"
              SelectedLoot="{Binding Owner.SelectedLoot}" LootRevision="{Binding Owner.LootRevision}"
              CreateLootCommand="{Binding CreateLootCommand}"
              SelectLootCommand="{Binding SelectLootCommand}" />
          <controls:ManualSecurityOverlayControl Cameras="{Binding Owner.SecurityCameras}" Guards="{Binding Owner.SecurityGuards}"
              Patrols="{Binding Owner.SecurityPatrols}" MapId="{Binding Map.Id}"
              IsHitTestVisible="{Binding IsSecurityEditMode}"
              ViewportZoom="{Binding Viewport.Zoom}"
              MapAspectRatio="{Binding Map.AspectRatio}" ShowCameras="{Binding ShowCameras}"
              ShowGuards="{Binding ShowGuards}" IsEditMode="{Binding IsSecurityEditMode}"
              SelectedCamera="{Binding Owner.SelectedSecurityCamera}" SelectedGuard="{Binding Owner.SelectedSecurityGuard}"
              SelectedPatrol="{Binding Owner.SelectedSecurityPatrol}" SelectedWaypointIndex="{Binding Owner.SelectedPatrolWaypointIndex}"
              Revision="{Binding Owner.SecurityRevision}" PlaceCommand="{Binding PlaceSecurityObjectCommand}"
              MoveCommand="{Binding MoveSecurityObjectCommand}" SelectCameraCommand="{Binding SelectSecurityCameraCommand}"
              SelectGuardCommand="{Binding SelectSecurityGuardCommand}" SelectWaypointCommand="{Binding SelectPatrolWaypointCommand}"
              MoveWaypointCommand="{Binding MovePatrolWaypointCommand}" />
          <controls:SewerOverlayControl IsVisible="{Binding IsSewer}"
              Paths="{Binding Owner.SewerPaths}" HighlightedPathIds="{Binding Owner.HighlightedSewerPathIds}"
              MapAspectRatio="{Binding Map.AspectRatio}" Revision="{Binding Owner.SewerRevision}"
              ViewportZoom="{Binding Viewport.Zoom}" IsRouteComplete="{Binding Owner.IsSewerRouteComplete}" />
        </Grid>
      </controls:MapViewportControl>
    </Grid>
  </Border>
</UserControl>
