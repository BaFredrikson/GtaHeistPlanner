<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GtaHeistPlanner.App.ViewModels" xmlns:models="using:GtaHeistPlanner.App.Models"
        xmlns:maps="using:GtaHeistPlanner.Core.Maps" xmlns:loot="using:GtaHeistPlanner.Core.Loot"
        xmlns:controls="using:GtaHeistPlanner.App.Controls"
        xmlns:views="using:GtaHeistPlanner.App.Views"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="850"
        x:Class="GtaHeistPlanner.App.Views.MainWindow" x:DataType="vm:MainViewModel"
        Width="1360" Height="850" MinWidth="900" MinHeight="600" Background="#11151B"
        Icon="/Assets/avalonia-logo.ico" Title="GTA Heist Planner — Kortz">
  <Design.DataContext><vm:MainViewModel /></Design.DataContext>

  <Grid RowDefinitions="58,48,*">
    <Border Background="#181E26" BorderBrush="#303946" BorderThickness="0,0,0,1" Padding="18,8">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="GTA HEIST PLANNER" FontSize="17" FontWeight="Bold" Foreground="#F3C969" />
          <TextBlock Text="Kortz Center" FontSize="10" Foreground="#98A4B3" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Content="New Heist" Padding="8,4" Command="{Binding NewHeistCommand}" />
          <Button Content="Save Heist" Padding="8,4" Command="{Binding SaveHeistCommand}" />
          <Button Content="Load Heist" Padding="8,4" Click="LoadHeistClicked" />
          <Button Content="End Heist" Padding="8,4" Command="{Binding EndHeistCommand}"
                  Background="#B83232" Foreground="White" BorderBrush="#E35D5D" />
        </StackPanel>
        <controls:NoWheelListBox Grid.Column="2" HorizontalAlignment="Center" ItemsSource="{Binding PlayerCountOptions}"
                 SelectedItem="{Binding SelectedPlayerCountOption}" Background="Transparent" BorderThickness="0">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate><DataTemplate x:DataType="models:PlayerCountOption"><TextBlock Text="{Binding Label}" Margin="11,5" FontWeight="SemiBold" /></DataTemplate></ListBox.ItemTemplate>
        </controls:NoWheelListBox>
        <Button Grid.Column="3" Width="38" Height="38" CornerRadius="19" Padding="0"
                Background="{Binding MicrophoneColor}" Command="{Binding ToggleMicrophoneCommand}"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                ToolTip.Tip="{Binding MicrophoneStatusText}">
          <Image Width="28" Height="28"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stretch="Uniform"
                 Source="avares://GtaHeistPlanner.App/Assets/icons/mic.PNG" />
        </Button>
        <Button Grid.Column="4" Width="28" Height="28" Padding="0" CornerRadius="4"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                ToolTip.Tip="Voice command guide" Command="{Binding OpenVoiceGuideCommand}">
          <TextBlock Text="?" FontSize="15" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
        </Button>
        <Button Grid.Column="5" Width="38" Height="38" Padding="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                ToolTip.Tip="Settings" Command="{Binding OpenSettingsCommand}">
          <Viewbox Width="18" Height="14">
            <Path Fill="#E8EDF3" Data="M1,1 H17 V3 H1 Z M1,6 H17 V8 H1 Z M1,11 H17 V13 H1 Z" />
          </Viewbox>
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#141920" BorderBrush="#303946" BorderThickness="0,0,0,1" Padding="18,5">
      <controls:NoWheelListBox ItemsSource="{Binding StageOptions}" SelectedItem="{Binding SelectedStageOption}"
               HorizontalAlignment="Center" Background="Transparent" BorderThickness="0">
        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate x:DataType="models:PlannerStageOption"><TextBlock Text="{Binding Label}" Margin="22,7" FontWeight="SemiBold" /></DataTemplate></ListBox.ItemTemplate>
      </controls:NoWheelListBox>
    </Border>

    <Border Grid.Row="2" Margin="24" Padding="24" Background="#181E26" BorderBrush="#303946"
            BorderThickness="1" CornerRadius="8" IsVisible="{Binding IsPlanningStage}">
      <ScrollViewer><StackPanel Spacing="16" MaxWidth="1000" HorizontalAlignment="Stretch">
        <TextBlock Text="HEIST PLANNING SUMMARY" FontSize="22" FontWeight="Bold" Foreground="#F3C969" />
        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
          <Border Padding="14" Background="#11151B" CornerRadius="6"><StackPanel><TextBlock Text="CREW" Foreground="#98A4B3" /><TextBlock Text="{Binding PlayerCount, StringFormat='{}{0} player(s)'}" FontSize="20" /></StackPanel></Border>
          <Border Grid.Column="1" Padding="14" Background="#11151B" CornerRadius="6"><StackPanel><TextBlock Text="BAG CAPACITY" Foreground="#98A4B3" /><TextBlock Text="{Binding PlanningSummary.BagCapacityPercent, StringFormat='{}{0}%'}" FontSize="20" /></StackPanel></Border>
          <Border Grid.Column="2" Padding="14" Background="#11151B" CornerRadius="6"><StackPanel><TextBlock Text="ACCESSIBLE POTENTIAL" Foreground="#98A4B3" /><TextBlock Text="{Binding PlanningPotentialRange}" FontSize="18" /></StackPanel></Border>
          <Border Grid.Row="1" Padding="14" Background="#11151B" CornerRadius="6"><StackPanel><TextBlock Text="SCOPED LOOT" Foreground="#98A4B3" /><TextBlock Text="{Binding PlanningSummary.PresentCount, StringFormat='{}{0} present'}" FontSize="18" /><TextBlock Text="{Binding PlanningSummary.KnownLocationCount, StringFormat='{}{0} known locations'}" /></StackPanel></Border>
          <Border Grid.Row="1" Grid.Column="1" Padding="14" Background="#11151B" CornerRadius="6"><StackPanel><TextBlock Text="BUYER'S REQUEST" Foreground="#98A4B3" /><TextBlock Text="{Binding PlanningSummary.BuyersRequestCount, StringFormat='{}{0} / 3'}" FontSize="20" /></StackPanel></Border>
          <Border Grid.Row="1" Grid.Column="2" Padding="14" Background="#11151B" CornerRadius="6"><StackPanel><TextBlock Text="ACCESS / PREP" Foreground="#98A4B3" /><TextBlock Text="{Binding PlanningSummary.InaccessibleCount, StringFormat='{}{0} inaccessible'}" /><TextBlock Text="{Binding PlanningSummary.GlassCutterCount, StringFormat='Glass Cutter: {0}'}" /><TextBlock Text="{Binding PlanningSummary.PowerDrillsCount, StringFormat='Power Drills: {0}'}" /></StackPanel></Border>
        </Grid>
        <TextBlock Text="LOOT BREAKDOWN" FontSize="15" FontWeight="Bold" />
        <ItemsControl ItemsSource="{Binding PlanningAnalysis.Categories}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16" Margin="0,3"><TextBlock Text="{Binding Name}" /><TextBlock Grid.Column="1" Text="{Binding TotalCount, StringFormat='{}{0} total'}" /><TextBlock Grid.Column="2" Text="{Binding AccessibleCount, StringFormat='{}{0} accessible'}" /><TextBlock Grid.Column="3" Text="{Binding TotalBagPercent, StringFormat='{}{0}% bag'}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <Border Padding="14" Background="#11151B" CornerRadius="6"><StackPanel Spacing="3">
            <TextBlock Text="VALUE ANALYSIS" FontWeight="Bold" Foreground="#75CFF4" />
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Known exact value" /><TextBlock Grid.Column="1" Text="{Binding PlanningKnownValue}" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Estimated unknown loot" /><TextBlock Grid.Column="1" Text="{Binding PlanningEstimatedRange}" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Potential accessible total" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding PlanningPotentialRange}" FontWeight="SemiBold" /></Grid>
            <TextBlock Text="{Binding PlanningAnalysis.AccessibleScopedBagPercent, StringFormat='{}{0}% accessible scoped bag use'}" Margin="0,5,0,0" />
            <TextBlock Text="{Binding PlanningAnalysis.ExcessAccessibleBagPercent, StringFormat='{}{0}% beyond crew capacity'}" Foreground="#E8A65A" />
          </StackPanel></Border>
          <Border Grid.Column="1" Padding="14" Background="#11151B" CornerRadius="6"><StackPanel Spacing="4">
            <TextBlock Text="ENTRY RECOMMENDATION" FontWeight="Bold" Foreground="#75CFF4" />
            <TextBlock Text="{Binding PlanningAnalysis.EntryRecommendation.DisplayEntry, StringFormat='Recommended Entry: {0}'}" FontSize="18" FontWeight="Bold" />
            <ItemsControl ItemsSource="{Binding PlanningAnalysis.EntryRecommendation.Reasons}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="10" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="Required areas" FontSize="10" FontWeight="SemiBold" Foreground="#98A4B3" Margin="0,5,0,0" />
            <ItemsControl ItemsSource="{Binding PlanningAnalysis.EntryRecommendation.RequiredAreas}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="10" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></Border>
        </Grid>
        <Border Padding="14" Background="#11151B" CornerRadius="6"><StackPanel Spacing="6">
          <TextBlock Text="RECOMMENDED HAUL PRIORITY" FontWeight="Bold" Foreground="#F3C969" />
          <TextBlock Text="Capacity recommendation only; not a physical route." FontSize="10" Foreground="#687484" />
          <ItemsControl ItemsSource="{Binding PlanningAnalysis.RecommendedHaul.SelectedLoot}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12" Margin="0,2">
            <TextBlock Text="{Binding Name}" /><TextBlock Grid.Column="1" Text="{Binding BagPercent, StringFormat='{}{0}% bag'}" />
            <TextBlock Grid.Column="2" Text="{Binding KnownExactValue, StringFormat='{}{0:$#,0}', TargetNullValue='estimated'}" />
            <TextBlock Grid.Column="3" Text="BUYER" Foreground="#FF5BA8" IsVisible="{Binding IsBuyersRequest}" />
          </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="{Binding PlanningAnalysis.RecommendedHaul.Diagnostic}" Foreground="#FF7777" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14"><TextBlock Text="Recommended total" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Text="{Binding PlanningAnalysis.RecommendedHaul.BagUsagePercent, StringFormat='{}{0}% used'}" />
            <TextBlock Grid.Column="2" Text="{Binding PlanningAnalysis.RecommendedHaul.RemainingCapacityPercent, StringFormat='{}{0}% spare'}" />
            <TextBlock Grid.Column="3" Text="{Binding RecommendedHaulRange}" FontWeight="Bold" />
          </Grid>
        </StackPanel></Border>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <Border Padding="14" Background="#11151B" CornerRadius="6"><StackPanel Spacing="4">
            <TextBlock Text="PREP RECOMMENDATIONS" FontWeight="Bold" Foreground="#75CFF4" />
            <TextBlock Text="{Binding PlanningAnalysis.GlassCutter.Recommendation, StringFormat='Glass Cutter: {0}'}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PlanningAnalysis.GlassCutter.Reason}" FontSize="10" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PlanningAnalysis.GlassCutter.TargetCount, StringFormat='{}{0} selected target(s)'}" FontSize="10" Foreground="#98A4B3" />
            <TextBlock Text="{Binding PlanningAnalysis.GlassCutter.BagPercent, StringFormat='{}{0}% selected bag usage'}" FontSize="10" Foreground="#98A4B3" />
            <TextBlock Text="{Binding PlanningAnalysis.PowerDrills.Recommendation, StringFormat='Power Drills: {0}'}" FontWeight="SemiBold" Margin="0,4,0,0" />
            <TextBlock Text="{Binding PlanningAnalysis.PowerDrills.Reason}" FontSize="10" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PlanningAnalysis.PowerDrills.TargetCount, StringFormat='{}{0} box target(s) in drills scenario'}" FontSize="10" Foreground="#98A4B3" />
          </StackPanel></Border>
          <Border Grid.Column="1" Padding="14" Background="#11151B" CornerRadius="6"><StackPanel Spacing="3">
            <TextBlock Text="BUYER'S REQUEST" FontWeight="Bold" Foreground="#FF5BA8" />
            <TextBlock Text="{Binding PlanningAnalysis.BuyersRequestCount, StringFormat='{}{0} / 3 targets'}" />
            <TextBlock Text="{Binding PlanningAnalysis.BuyersRequestBagPercent, StringFormat='{}{0}% reserved bag usage'}" />
            <TextBlock Text="{Binding PlanningAnalysis.InaccessibleBuyersRequestIds.Count, StringFormat='{}{0} inaccessible for this crew'}" Foreground="#E8A65A" />
          </StackPanel></Border>
        </Grid>
      </StackPanel></ScrollViewer>
    </Border>

    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" Margin="18" IsVisible="{Binding IsMapStage}">
        <StackPanel Orientation="Horizontal" Margin="4,0,0,6" Spacing="10">
          <TextBlock Text="{Binding StageTitle}" FontSize="21" FontWeight="Bold" Foreground="#F3C969" />
          <TextBlock VerticalAlignment="Center" Text="{Binding StageDescription}" FontSize="11" Foreground="#98A4B3" />
        </StackPanel>

        <Border Grid.Row="1" Margin="4,0,4,8" Padding="9,4" Background="#181E26" CornerRadius="5">
          <TextBlock Text="{Binding VoiceHint}" FontSize="11" Foreground="#98A4B3" TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <ItemsControl ItemsSource="{Binding VisibleMapCards}" IsVisible="{Binding !HasFocusedMap}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MapCardViewModel">
                  <views:MapCardView />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasFocusedMap}">
            <Button HorizontalAlignment="Left" Margin="5,0,0,4" Padding="12,5" Content="← Back to map overview"
                    Command="{Binding ExitMapFocusCommand}" />
            <ContentControl Grid.Row="1" Content="{Binding FocusedMapCard}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:MapCardViewModel"><views:MapCardView /></DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Grid>

          <Border Grid.Column="1" Width="300" Padding="14" Background="#181E26" BorderBrush="#303946" BorderThickness="1" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding StageTitle}" FontWeight="Bold" Foreground="#F3C969" />
                <TextBlock Text="{Binding StageDescription}" FontSize="11" Foreground="#98A4B3" TextWrapping="Wrap" />

                <StackPanel Spacing="4" IsVisible="{Binding IsPreparationStage}">
                  <TextBlock Text="Vault Code" FontWeight="SemiBold" />
                  <TextBox Text="{Binding VaultCode}" PlaceholderText="12-34-56" />
                </StackPanel>
                <Border Padding="12" Background="#102634" BorderBrush="#75CFF4" BorderThickness="1" CornerRadius="6" IsVisible="{Binding IsActivityStage}">
                  <StackPanel>
                    <TextBlock Text="VAULT CODE" FontSize="10" FontWeight="Bold" Foreground="#75CFF4" />
                    <TextBlock Text="{Binding VaultCode, TargetNullValue='Not discovered'}" FontSize="24" FontWeight="Bold" />
                  </StackPanel>
                </Border>

                <StackPanel Spacing="7" IsVisible="{Binding IsLootStage}">
                  <TextBlock Text="{Binding BuyersRequestStatus}" FontWeight="SemiBold" />
                  <Button Content="Reset heist loot state" Command="{Binding ResetHeistCommand}" />
                  <StackPanel Spacing="5" IsVisible="{Binding HasSelectedLoot}">
                    <Separator Margin="0,4" /><TextBlock Text="SELECTED LOOT" FontWeight="Bold" />
                    <TextBlock Text="{Binding SelectedLoot.Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedLoot.Economics.DisplayName}" FontSize="11" />
                    <TextBlock Text="{Binding SelectedLoot.Economics.BagPercent, StringFormat='Bag usage: {0}%'}" FontSize="11" />
                    <TextBlock Text="{Binding SelectedLoot.EstimatedValueDisplay, StringFormat='Estimated: {0}'}" FontSize="11" />
                    <TextBlock Text="Exact scoped value" FontSize="10" Foreground="#98A4B3" />
                    <NumericUpDown Value="{Binding SelectedLoot.ScopedValue}" Minimum="0" Maximum="10000000"
                                   Increment="1000" FormatString="N0" AllowSpin="True" />
                    <TextBlock Text="{Binding SelectedLoot.AccessDisplay}" FontSize="11" TextWrapping="Wrap" />
                    <CheckBox Content="Present" IsChecked="{Binding SelectedLoot.IsPresent, Mode=OneWay}" Command="{Binding ToggleLootPresentCommand}" />
                    <CheckBox Content="Buyer's Request" IsChecked="{Binding SelectedLoot.IsBuyersRequest, Mode=OneWay}" Command="{Binding ToggleBuyersRequestCommand}" />
                    <CheckBox Content="Looted" IsChecked="{Binding SelectedLoot.IsLooted, Mode=OneWay}" Command="{Binding ToggleLootedCommand}" />
                  </StackPanel>
                </StackPanel>

                <Border Padding="10" Background="#11151B" CornerRadius="6" IsVisible="{Binding IsInfiltrationStage}">
                  <StackPanel Spacing="3">
                    <TextBlock Text="INFILTRATION STATUS" FontWeight="Bold" Foreground="#F3C969" />
                    <TextBlock Text="{Binding GuardsDownDisplay}" />
                    <TextBlock Text="{Binding CamerasDownDisplay}" Foreground="{Binding CameraStatusColor}" />
                  </StackPanel>
                </Border>

                <StackPanel Spacing="6" IsVisible="{Binding IsActivityStage}">
                  <Border Padding="10" Background="#11151B" CornerRadius="6">
                    <StackPanel Spacing="3">
                      <TextBlock Text="HEIST STATUS" FontWeight="Bold" Foreground="#F3C969" />
                      <TextBlock Text="{Binding GuardsDownDisplay}" />
                      <TextBlock Text="{Binding CamerasDownDisplay}" Foreground="{Binding CameraStatusColor}" />
                      <TextBlock Text="{Binding ActivityLootSummary}" FontSize="10" Foreground="#98A4B3" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Separator Margin="0,8,0,3" />
                  <TextBlock Text="ACTIVE SECURITY" FontWeight="Bold" Foreground="#75CFF4" />
                  <TextBlock Text="Toggle elements for the chosen entry approach." FontSize="10" Foreground="#98A4B3" TextWrapping="Wrap" />
                  <TextBlock Text="Cameras" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding CurrentMapCameras}">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SecurityCameraViewModel"><CheckBox Content="{Binding Name}" IsChecked="{Binding IsActive}" /></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Guards" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding CurrentMapGuards}">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SecurityGuardViewModel"><CheckBox Content="{Binding Name}" IsChecked="{Binding IsActive}" /></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Patrols" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding CurrentMapPatrols}">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SecurityPatrolViewModel"><CheckBox Content="{Binding Name}" IsChecked="{Binding IsActive}" /></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <CheckBox Content="Interaction points" IsChecked="{Binding ShowInteractionMarkers}"
                          IsVisible="{Binding IsMapStage}" />

                <StackPanel Spacing="7" IsVisible="{Binding DeveloperMode}">
                  <Separator Margin="0,8,0,3" /><TextBlock Text="DEVELOPER TOOLS" FontWeight="Bold" Foreground="#E8A65A" />
                  <StackPanel Spacing="5">
                    <TextBlock Text="VOICE COMMANDS" FontWeight="Bold" Foreground="#75CFF4" />
                    <TextBlock Text="{Binding VoiceRecognitionState, StringFormat='Recognition: {0}'}" FontSize="10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ConfiguredCaptureDevice, StringFormat='Capture: {0}'}" FontSize="10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TransmittedAudioFormat, StringFormat='Transmitted: {0}'}" FontSize="10" />
                    <TextBlock Text="{Binding VoiceUiHeartbeat, StringFormat='UI heartbeat: {0:HH:mm:ss.fff}', TargetNullValue='UI heartbeat: —'}" FontSize="10" />
                    <TextBlock Text="{Binding ScopeOutState, StringFormat='Session: {0}'}" FontSize="10" />
                    <TextBlock Text="{Binding CurrentStage, StringFormat='Stage: {0}'}" FontSize="10" />
                    <TextBlock Text="{Binding VoiceContextSummary, StringFormat='Context: {0}'}" FontSize="10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding GuardsDownDisplay}" FontSize="10" />
                    <TextBlock Text="{Binding CamerasDownDisplay}" FontSize="10" Foreground="{Binding CameraStatusColor}" />
                    <TextBlock Text="{Binding CurrentPartialTranscript, StringFormat='Partial: {0}', TargetNullValue='Partial: —'}" FontSize="10" Foreground="#E8A65A" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LastRecognizedText, StringFormat='Heard: {0}', TargetNullValue='Heard: —'}" FontSize="10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LastParsedVoiceCommand, StringFormat='Parsed: {0}', TargetNullValue='Parsed: —'}" FontSize="10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LastVoiceLootUpdate, StringFormat='Applied: {0}', TargetNullValue='Applied: —'}" FontSize="10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding VoiceCommandError, StringFormat='Error: {0}'}" FontSize="10" Foreground="#FFB8B8" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding VoiceStartupDiagnostics}" FontFamily="Consolas" FontSize="9"
                               Foreground="#98A4B3" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LocalModelDownloadDiagnostics}" FontFamily="Consolas" FontSize="9"
                               Foreground="#98A4B3" TextWrapping="Wrap" />
                    <TextBox Text="{Binding VoiceSimulatorText}" PlaceholderText="scope out" />
                    <Button Content="Simulate recognized text" Command="{Binding SimulateRecognizedTextCommand}" />
                    <TextBlock Text="{Binding SaveStatus}" FontSize="10" Foreground="#98A4B3" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding HeistSavePath}" FontSize="9" Foreground="#687484" TextWrapping="Wrap" />
                  </StackPanel>
                  <CheckBox Content="Edit loot locations" IsChecked="{Binding IsLootEditMode}" IsVisible="{Binding IsLootStage}" />
                  <TextBlock Text="Click empty map space to add a loot location." FontSize="10" Foreground="#98A4B3" IsVisible="{Binding IsLootAuthoringEnabled}" />
                  <StackPanel Spacing="5" IsVisible="{Binding IsLootAuthoringEnabled}">
                    <TextBox Text="{Binding SelectedLoot.Name}" PlaceholderText="Selected loot name" />
                    <ComboBox ItemsSource="{Binding LootTypes}" SelectedItem="{Binding SelectedLoot.SelectedEconomics}">
                      <ComboBox.ItemTemplate><DataTemplate x:DataType="loot:LootEconomics"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Content="Albert Crisp Gallery (2 players)" IsChecked="{Binding SelectedLoot.IsCrispGallery}" />
                    <Button Content="Remove selected marker" Command="{Binding RemoveSelectedLootCommand}" />
                    <Button Content="Save loot layout" Command="{Binding SaveLootLayoutCommand}" />
                    <TextBlock Text="{Binding LootStatus}" FontSize="10" Foreground="#FFB8B8" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding ShowDeveloperCalibration}">
                    <Separator Margin="0,6" /><TextBlock Text="MAP CALIBRATION / DEBUG" FontWeight="Bold" />
                    <TextBlock Text="Scale X" /><NumericUpDown Value="{Binding ScaleX}" Minimum="-1" Maximum="1" Increment="0.0005" FormatString="0.000000" />
                    <TextBlock Text="Scale Y" /><NumericUpDown Value="{Binding ScaleY}" Minimum="-1" Maximum="1" Increment="0.0005" FormatString="0.000000" />
                    <TextBlock Text="Offset X" /><NumericUpDown Value="{Binding OffsetX}" Minimum="-5" Maximum="5" Increment="0.01" FormatString="0.0000" />
                    <TextBlock Text="Offset Y" /><NumericUpDown Value="{Binding OffsetY}" Minimum="-5" Maximum="5" Increment="0.01" FormatString="0.0000" />
                    <TextBlock Text="Rotation" /><NumericUpDown Value="{Binding RotationDegrees}" Minimum="-360" Maximum="360" Increment="1" />
                    <CheckBox Content="Flip X" IsChecked="{Binding FlipX}" /><CheckBox Content="Flip Y" IsChecked="{Binding FlipY}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6"><Button Content="Fit Data" Command="{Binding FitDataCommand}" /><Button Grid.Column="1" Content="Reset" Command="{Binding ResetCommand}" /></Grid>
                    <Button Content="Save calibration" Command="{Binding SaveCalibrationCommand}" />
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding IsSecurityEditorVisible}">
                    <Separator Margin="0,6" />
                    <TextBlock Text="SECURITY EDITOR" FontWeight="Bold" Foreground="#75CFF4" />
                    <TextBlock Text="Choose a tool, then click the map. Drag cameras or guards to move them." FontSize="10" Foreground="#98A4B3" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding SecurityEditorTools}" SelectedItem="{Binding SecurityEditorTool}" />

                    <TextBlock Text="Selected camera" FontWeight="SemiBold" />
                    <TextBox Text="{Binding SelectedSecurityCamera.Name}" PlaceholderText="Select a camera" />
                    <TextBlock Text="Rotation / heading (degrees)" FontSize="10" />
                    <NumericUpDown Value="{Binding SelectedSecurityCamera.RotationDegrees}" Minimum="-360" Maximum="360" Increment="5" />
                    <TextBlock Text="Field of view (degrees)" FontSize="10" />
                    <NumericUpDown Value="{Binding SelectedSecurityCamera.FovDegrees}" Minimum="1" Maximum="179" Increment="1" />
                    <TextBlock Text="Range (normalized map units)" FontSize="10" />
                    <NumericUpDown Value="{Binding SelectedSecurityCamera.Range}" Minimum="0.01" Maximum="2" Increment="0.01" FormatString="0.00" />
                    <Button Content="Remove selected camera" Command="{Binding RemoveSelectedCameraCommand}" />

                    <TextBlock Text="Selected guard" FontWeight="SemiBold" />
                    <TextBox Text="{Binding SelectedSecurityGuard.Name}" PlaceholderText="Select a guard" />
                    <TextBlock Text="Assigned patrols" FontSize="10" />
                    <ItemsControl ItemsSource="{Binding SelectedGuardPatrolAssignments}">
                      <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PatrolAssignmentViewModel"><CheckBox Content="{Binding Name}" IsChecked="{Binding IsAssigned}" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Remove selected guard" Command="{Binding RemoveSelectedGuardCommand}" />

                    <TextBlock Text="Patrol routes" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding CurrentMapPatrols}" SelectedItem="{Binding SelectedSecurityPatrol}" />
                    <TextBox Text="{Binding SelectedSecurityPatrol.Name}" PlaceholderText="Selected patrol name" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                      <Button Content="New patrol" Command="{Binding NewSecurityPatrolCommand}" />
                      <Button Grid.Column="1" Content="Remove patrol" Command="{Binding RemoveSelectedPatrolCommand}" />
                    </Grid>
                    <Button Content="Delete selected patrol node" Command="{Binding DeleteSelectedPatrolWaypointCommand}" IsEnabled="{Binding HasSelectedPatrolWaypoint}" />
                    <Button Content="Save security JSON" Command="{Binding SaveSecurityDatasetCommand}" />
                    <TextBlock Text="{Binding SecurityStatus}" FontSize="10" Foreground="#FFB8B8" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SecurityDataPath}" FontSize="9" Foreground="#687484" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding IsInteractionEditorVisible}">
                    <Separator Margin="0,6" />
                    <TextBlock Text="INTERACTION MARKERS" FontWeight="Bold" Foreground="#75CFF4" />
                    <TextBlock Text="Choose a marker, click to place it, or drag an existing marker."
                               FontSize="10" Foreground="#98A4B3" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding InteractionEditorTools}" SelectedItem="{Binding SecurityEditorTool}" />
                    <TextBox Text="{Binding SelectedInteractionMarker.DisplayName}" PlaceholderText="Optional marker label" />
                    <Button Content="Remove selected marker" Command="{Binding RemoveSelectedInteractionMarkerCommand}" />
                    <Button Content="Save authored map data" Command="{Binding SaveSecurityDatasetCommand}" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="7" IsVisible="{Binding IsSewerSelected}">
                  <Separator Margin="0,8,0,3" /><TextBlock Text="SEWER ESCAPE ROUTE" FontWeight="Bold" Foreground="#F3C969" />
                  <Border Padding="8,5" Background="#102634" CornerRadius="5">
                    <TextBlock Text="Say chamber numbers with: Alpha · Bravo · Charlie · Delta · Echo"
                               FontSize="10" Foreground="#75CFF4" TextWrapping="Wrap" />
                  </Border>
                  <TextBox Text="{Binding SewerRouteInput}" PlaceholderText="2C 1B" />
                  <Button Content="Apply route" Command="{Binding ApplySewerRouteCommand}" />
                  <TextBlock Text="{Binding SewerDiagnostic}" FontSize="11" Foreground="#FFB8B8" TextWrapping="Wrap" />
                  <TextBlock Text="Topology is authored in the sewer JSON using chamber-letter labels and neutral physical path IDs."
                             FontSize="10" Foreground="#687484" TextWrapping="Wrap" IsVisible="{Binding DeveloperMode}" />
                  <TextBlock Text="{Binding SewerGraphPath}" FontSize="9" Foreground="#687484" TextWrapping="Wrap" IsVisible="{Binding DeveloperMode}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
    </Grid>

    <Border Grid.RowSpan="3" Width="430" MaxHeight="220" Margin="18"
            HorizontalAlignment="Left" VerticalAlignment="Bottom" ZIndex="50"
            Padding="12" Background="#F2181E26" BorderBrush="#E24B4B" BorderThickness="1"
            CornerRadius="8" IsVisible="{Binding IsMicrophoneOpen}">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding MicrophoneColor}" />
            <TextBlock Text="LIVE RECOGNITION" FontWeight="Bold" Foreground="#E8EDF3" />
            <TextBlock Text="{Binding ScopeOutState}" Foreground="#98A4B3" />
          </StackPanel>
          <Button Grid.Column="1" Content="Clear" Padding="8,2" Command="{Binding ClearVoiceTranscriptCommand}" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding VoiceTranscript}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:VoiceTranscriptEntry">
                <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" FontSize="14"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,118,0,0"
            ZIndex="90" Padding="16,9" CornerRadius="7" Background="#F21C232D"
            BorderBrush="{Binding CurrentVoiceFeedback.Color}" BorderThickness="1"
            IsVisible="{Binding HasVoiceFeedback}">
      <TextBlock Text="{Binding CurrentVoiceFeedback.Message}" Foreground="{Binding CurrentVoiceFeedback.Color}"
                 FontSize="15" FontWeight="SemiBold" />
    </Border>

    <Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding IsVoiceGuideOpen}" ZIndex="105">
      <Border Width="560" MaxHeight="650" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="#1C232D" BorderBrush="#465364" BorderThickness="1" CornerRadius="10">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
          <StackPanel>
            <TextBlock Text="VOICE COMMANDS" FontSize="20" FontWeight="Bold" Foreground="#F3C969" />
            <TextBlock Text="{Binding StageTitle, StringFormat='Commands for {0}'}" Foreground="#98A4B3" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CurrentVoiceGuideGroups}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:VoiceGuideGroup">
                <StackPanel Margin="0,4,0,10" Spacing="3">
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#75CFF4" />
                  <ItemsControl ItemsSource="{Binding Phrases}"><ItemsControl.ItemTemplate><DataTemplate>
                    <TextBlock Text="{Binding StringFormat='“{0}”'}" Margin="8,1" />
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button Grid.Row="2" HorizontalAlignment="Right" Width="90" Content="Close" Command="{Binding CloseVoiceGuideCommand}" />
        </Grid>
      </Border>
    </Border>

    <Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding IsSettingsOpen}" ZIndex="100">
      <Border Width="520" MaxHeight="760" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="#1C232D" BorderBrush="#465364" BorderThickness="1" CornerRadius="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12">
          <TextBlock Text="SETTINGS" FontSize="20" FontWeight="Bold" Foreground="#F3C969" />
          <TextBlock Text="Recording device" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding RecordingDevices}" SelectedItem="{Binding SelectedRecordingDevice}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="models:RecordingDeviceInfo"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <CheckBox Content="Microphone enabled" IsChecked="{Binding MicrophoneEnabled}" />
          <Separator Margin="0,4" />
          <TextBlock Text="VOICE RECOGNITION" FontWeight="SemiBold" Foreground="#75CFF4" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <RadioButton Content="Local Whisper" GroupName="VoiceProvider" IsChecked="{Binding UseLocalWhisper}" />
            <RadioButton Content="OpenAI" GroupName="VoiceProvider" IsChecked="{Binding UseOpenAi}" />
            <RadioButton Content="Custom / compatible" GroupName="VoiceProvider" IsChecked="{Binding UseCustomTranscription}" />
          </StackPanel>

          <Border Padding="10" Background="#11151B" CornerRadius="6" IsVisible="{Binding UseLocalWhisper}">
            <StackPanel Spacing="7">
              <TextBlock Text="Local Whisper (recommended, offline)" FontWeight="SemiBold" />
              <TextBlock Text="Model" FontSize="10" Foreground="#98A4B3" />
              <ComboBox ItemsSource="{Binding LocalWhisperModels}" SelectedItem="{Binding SelectedLocalWhisperModel}" />
              <TextBlock Text="Compute" FontSize="10" Foreground="#98A4B3" />
              <ComboBox ItemsSource="{Binding LocalWhisperComputeOptions}" SelectedItem="{Binding SelectedLocalWhisperCompute}" />
              <TextBlock Text="{Binding LocalWhisperBackendStatus, StringFormat='Active backend: {0}'}"
                         FontSize="10" Foreground="#98A4B3" TextWrapping="Wrap" />
              <TextBlock Text="{Binding LocalModelStatus, StringFormat='Model status: {0}'}" />
              <ProgressBar Minimum="0" Maximum="1" Value="{Binding LocalModelDownloadProgress}"
                           IsIndeterminate="{Binding IsLocalModelDownloadIndeterminate}" Height="5" />
              <TextBlock Text="{Binding LocalModelDownloadProgressText}" FontSize="10" Foreground="#98A4B3" />
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                <Button Content="Download model" Command="{Binding DownloadLocalWhisperModelCommand}" />
                <Button Grid.Column="1" Content="Remove model" Command="{Binding RemoveLocalWhisperModelCommand}" />
                <Button Grid.Column="2" Content="Test" Command="{Binding TestVoiceProviderCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Padding="10" Background="#11151B" CornerRadius="6" IsVisible="{Binding UseOpenAi}">
            <StackPanel Spacing="7">
              <TextBlock Text="OpenAI realtime transcription" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding OpenAiTranscriptionModels}" SelectedItem="{Binding SelectedOpenAiModel}" />
              <TextBox Text="{Binding OpenAiApiKeyInput}" PasswordChar="*" PlaceholderText="API key (leave blank to keep saved key)" />
              <Button Content="Test configuration" Command="{Binding TestVoiceProviderCommand}" />
            </StackPanel>
          </Border>

          <Border Padding="10" Background="#11151B" CornerRadius="6" IsVisible="{Binding UseCustomTranscription}">
            <StackPanel Spacing="7">
              <TextBlock Text="Custom / OpenAI-compatible (Advanced)" FontWeight="SemiBold" />
              <TextBox Text="{Binding CustomTranscriptionEndpoint}" PlaceholderText="Base URL, e.g. http://localhost:8000/v1/" />
              <TextBox Text="{Binding CustomTranscriptionModel}" PlaceholderText="Model" />
              <TextBox Text="{Binding CustomApiKeyInput}" PasswordChar="*" PlaceholderText="Optional API key" />
              <TextBlock Text="Requires an OpenAI-compatible POST /audio/transcriptions response with a text field."
                         FontSize="10" Foreground="#98A4B3" TextWrapping="Wrap" />
              <Button Content="Test connection" Command="{Binding TestVoiceProviderCommand}" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding VoiceProviderTestStatus}" FontSize="11" Foreground="#F3C969" TextWrapping="Wrap" />
          <Separator Margin="0,4" /><TextBlock Text="Developer" FontWeight="SemiBold" />
          <CheckBox Content="Developer Mode" IsChecked="{Binding DeveloperMode}" />
          <TextBlock Text="Shows authoring, calibration, and debug controls." FontSize="11" Foreground="#98A4B3" />
          <TextBlock Text="{Binding SettingsPath}" FontSize="10" Foreground="#687484" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,6,0,0">
            <Button Content="Cancel" Command="{Binding CloseSettingsCommand}" />
            <Button Grid.Column="1" Content="Save" Command="{Binding SaveSettingsCommand}" />
          </Grid>
        </StackPanel></ScrollViewer>
      </Border>
    </Border>

    <Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding IsNewHeistConfirmationOpen}" ZIndex="110">
      <Border Width="460" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="#1C232D" BorderBrush="#465364" BorderThickness="1" CornerRadius="10">
        <StackPanel Spacing="12">
          <TextBlock Text="Start a new heist attempt?" FontSize="20" FontWeight="Bold" Foreground="#F3C969" />
          <TextBlock Text="Preparation and planning data will be kept. Infiltration and heist progress will be reset."
                     TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Content="Cancel" Command="{Binding CancelNewHeistCommand}" />
            <Button Grid.Column="1" Content="New Heist" Command="{Binding ConfirmNewHeistCommand}" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding IsLoadHeistConfirmationOpen}" ZIndex="110">
      <Border Width="460" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="#1C232D" BorderBrush="#465364" BorderThickness="1" CornerRadius="10">
        <StackPanel Spacing="12">
          <TextBlock Text="Load selected heist?" FontSize="20" FontWeight="Bold" Foreground="#F3C969" />
          <TextBlock Text="The loaded file will replace current in-memory progress and become current-heist.json. The source file will not be changed."
                     TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Content="Cancel" Command="{Binding CancelLoadHeistCommand}" />
            <Button Grid.Column="1" Content="Load Heist" Command="{Binding ConfirmLoadHeistCommand}" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding IsEndHeistConfirmationOpen}" ZIndex="120">
      <Border Width="500" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="#1C232D" BorderBrush="#E35D5D" BorderThickness="1" CornerRadius="10">
        <StackPanel Spacing="12">
          <TextBlock Text="End current heist?" FontSize="20" FontWeight="Bold" Foreground="#FF7777" />
          <TextBlock Text="This will clear all current heist progress, including scoped loot, values, Buyer's Request selections, vault code, infiltration state, and collected loot. This cannot be undone."
                     TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Content="Cancel" Command="{Binding CancelEndHeistCommand}" />
            <Button Grid.Column="1" Content="End Heist" Command="{Binding ConfirmEndHeistCommand}"
                    Background="#B83232" Foreground="White" BorderBrush="#E35D5D" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
